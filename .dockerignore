# The Statcast cache is ~355MB and lives on the Railway volume, not in
# the image. Never ship it in the build context.
data/statcast_cache/
data/backfill/
data/chadwick_cache/
data/game_context_cache/

# Dashboard is built and served by Vercel, not the worker.
dashboard/node_modules/
dashboard/.next/
dashboard/out/

# .git/ is deliberately NOT excluded here -- but do not rely on that
# alone. Railway's builder ships a source ARCHIVE, not a clone: its
# build log reads "fetching snapshot" then "unpacking archive", so the
# build context contains no .git to copy in the first place. Removing
# the exclusion (A-029) was a genuine fix and changed nothing on
# Railway. What actually makes the worker a checkout is
# `_bootstrap_repo()` in tools/railway_worker.py, which runs git
# init/fetch/reset at boot.
#
# Keep the exclusion off anyway: it costs 9.3 MB, it makes a locally
# built image behave like the deployed one, and re-adding it would break
# any builder that DOES provide .git.
logs/
__pycache__/
*.pyc
.venv/
venv/
.vercel/
